# Kalshi API credentials. Required for live mode; not needed for dry-run.
# Generate from your Kalshi account settings → API Keys.
KALSHI_API_KEY_ID=
# Path to the RSA private key PEM file Kalshi gave you. Keep this OUT of git.
KALSHI_PRIVATE_KEY_PATH=./kalshi.pem

# Kalshi environment. Default is the demo/sandbox; set to "prod" only when ready
# to trade real money.
KALSHI_ENV=demo

# Optional: OpenWeatherMap API key for the dashboard's live temperature
# overlay on the Weather Map. Free tier is enough. Without it the map still
# shows the basemap + per-city forecast markers, just no temperature field.
# https://openweathermap.org/api  (free "Weather Maps 1.0" tile layer)
OPENWEATHER_API_KEY=
